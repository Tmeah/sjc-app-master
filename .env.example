# Contentful Content Delivery API credentials (Settings > API keys)
REACT_APP_CONTENTFUL_SPACE_ID=your_space_id
REACT_APP_CONTENTFUL_ACCESS_TOKEN=your_delivery_access_token
REACT_APP_CONTENTFUL_ENVIRONMENT=master

# Stripe publishable key (pk_test_... or pk_live_...)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Used by netlify/functions/charge.js - set in Netlify, never commit
STRIPE_SECRET_KEY=sk_test_your_secret_key
